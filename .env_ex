
# Diretório base para volumes bind
#DATA_DIR=/srv/docker/volumes/npm



# Timezone
TZ=America/Maceio

# Configurações do Banco de Dados MariaDB
MYSQL_ROOT_PASSWORD=xxxxxxxxxxxxxxxxxxx
MYSQL_DATABASE=npm
MYSQL_USER=npm
MYSQL_PASSWORD=xxxxxxxxxxxxxxxxxxx

# Notas:
# - Altere DATA_DIR se quiser usar outro caminho para os volumes
# - PUID e PGID devem corresponder ao usuário do sistema (geralmente 1000)
# - Altere TZ para seu timezone
# - Altere todas as senhas para senhas fortes e únicas
# - Não compartilhe este arquivo .env publicamente